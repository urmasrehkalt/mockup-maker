# Kopeeri see fail nimega .env ja muuda vajadusel väärtusi.
# .env on git-ignoreeritud: ära pane saladusi repositooriumi.

# development | test | production. Kui puudub, eeldatakse development.
ENVIRONMENT=development

# SQLite andmebaasi fail. Suhteline tee on projekti juurkausta suhtes.
DATABASE_PATH=data/mockup-maker.db

# Port, mida ./start.sh kasutab (Agile Tracker kasutab 8000).
PORT=8010

# --- AI ---
# codex = Codex CLI ChatGPT tellimusega, mock = kohalikud näidisvastused (ei vaja võrku),
# off = AI välja lülitatud (käsitsi töö toimib edasi). Vaikimisi mock.
AI_PROVIDER=mock
# Mudel ja mõtlemise tase (low | medium | high); low hoiab vestluse kiire.
AI_MODEL=gpt-6-astra
AI_REASONING=low
# Sekundid, mille järel Codexi protsess katkestatakse.
AI_TIMEOUT=180
# Codex CLI absoluutne tee (vajalik systemd all); tühjana otsitakse PATH-ist.
CODEX_BIN=
# Kaust, kus asub Codexi sisselogimine (auth.json); tühjana ~/.codex.
CODEX_HOME=
